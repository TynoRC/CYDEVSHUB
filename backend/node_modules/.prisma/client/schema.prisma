generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  CLIENT
  DEVELOPER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  orders    Order[]
  posts     ForumPost[]
  feedbacks Feedback[]
}

model Order {
  id          Int         @id @default(autoincrement())
  title       String
  projectType String
  description String
  status      OrderStatus @default(PENDING)

  assignedDeveloperName  String?
  assignedDeveloperEmail String?
  price                  Float?
  developerCut           Float?
  paymentIban            String?

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Feedback {
  id             Int      @id @default(autoincrement())
  developerName  String
  developerEmail String
  rating         Int
  satisfaction   Int
  message        String
  projectTitle   String?
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
}
